{
  "name": "orbit-arena",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:browsers": "node tests/browser/determinism.mjs",
    "snapshots:update": "UPDATE_SNAPSHOTS=1 vitest run tests/determinism.test.ts",
    "daily": "vite-node scripts/build-daily.ts",
    "flags": "node scripts/copy-flags.mjs",
    "build:native": "tsc --noEmit && vite build -c vite.native.config.ts && node scripts/build-native.mjs"
  },
  "dependencies": {
    "@fontsource/saira-semi-condensed": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "flag-icons": "^7.6.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-node": "^6.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^4.1.12"
  }
}
