{
  "expo": {
    "name": "Orbit Arena",
    "slug": "orbit-arena",
    "version": "0.3.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07080e",
    "ios": {
      "bundleIdentifier": "com.rhettlindell.orbitarena",
      "appleTeamId": "V7YLBXSTX2",
      "buildNumber": "1",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "UIStatusBarStyle": "UIStatusBarStyleLightContent",
        "NSPhotoLibraryAddUsageDescription": "Lets you save your Orbit Arena videos to Photos."
      }
    },
    "android": {
      "package": "com.rhettlindell.orbitarena",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07080e"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#07080e"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-sharing",
      [
        "expo-iap",
        {
          "android": {
            "store": "play"
          }
        }
      ],
      "./plugins/withoutDevLauncherKeys",
      "./plugins/withSceneLifecycle"
    ],
    "extra": {
      "eas": {
        "projectId": "4f03c308-003a-445e-a0f9-f17c970a4bd1"
      }
    },
    "owner": "rhettl08"
  }
}
